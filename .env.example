DATABASE_URL=
GAT_INTEGRATION=
PAYLOAD_API_KEY=
PAYLOAD_COORDINATION_LOCAL=
PAYLOAD_COORDINATION_URL=
PAYLOAD_NOTATION_STATE_DIR=
PAYLOAD_PRODUCTION_DIR=
PAYLOAD_PRODUCTION_LOCAL=
PAYLOAD_SAMSARA_COLLECTION=
PAYLOAD_SAMSARA_TOKEN=
PAYLOAD_SOURCE_COLLECTION=
PAYLOAD_SOURCE_QUALIFICATION_DIR=
PAYLOAD_STATE_KERNEL_LOCAL=
SQL_DB_NAME=
SQL_HOST=
SQL_PASSWORD=
SQL_PORT=
SQL_USER=

# Optional internal packaging. Local development remains loopback-only.
PAYLOAD_DEPLOYMENT_MODE=local
PAYLOAD_INTERNAL_ORIGIN=http://127.0.0.1:3000
PAYLOAD_OPERATOR_USERNAME=
PAYLOAD_OPERATOR_PASSWORD_FILE=
PAYLOAD_DB_TLS_MODE=
PAYLOAD_DB_CA_FILE=
# Operator-managed JSON registry; token hashes, scopes and reviewer standing.
# See docs/TERMINAL_OPERATING_CONTRACT.md. Never put plaintext tokens in Git.
PAYLOAD_TERMINAL_PRINCIPALS=

# Opt-in internal artifact custody; disabled does not backfill historical jobs.
PAYLOAD_TERMINAL_RETENTION=disabled
PAYLOAD_TERMINAL_OBJECT_ROOT=
PAYLOAD_OBJECT_STORE=local
PAYLOAD_SOS_ENDPOINT=
PAYLOAD_SOS_REGION=
PAYLOAD_SOS_BUCKET=
PAYLOAD_SOS_PREFIX=
PAYLOAD_SOS_ACCESS_KEY_ID=
# Set ONE of PAYLOAD_SOS_SECRET_ACCESS_KEY or this mounted-file setting, not both.
PAYLOAD_SOS_SECRET_ACCESS_KEY_FILE=
PAYLOAD_SOS_MAX_BYTES=
PAYLOAD_SOS_TIMEOUT_MS=
PAYLOAD_SOS_MAX_CONCURRENCY=

# Optional fixture-only local Iceberg qualification, never internal deployment.
PAYLOAD_LAKE_PYTHON=
PAYLOAD_LAKE_PYTHON_PACKAGES=
PAYLOAD_LAKE_ROOT=

# Optional reasoning is operator tooling, NOT a terminal execution grant.
PAYLOAD_REASONING_PROVIDER=disabled
PAYLOAD_REASONING_RUN_DIR=
PAYLOAD_SAKANA_MODEL=
PAYLOAD_SAKANA_PROCESSING_REVIEW_REF=
SAKANA_API_KEY_FILE=
PAYLOAD_SAKANA_TIMEOUT_MS=
PAYLOAD_SAKANA_MAX_OUTPUT_TOKENS=
# Separate opt-in Python environment; do not share the Iceberg dependencies.
PAYLOAD_SAKANA_TOOLS=0
PAYLOAD_SAKANA_TOOLS_PYTHON=
PAYLOAD_SAKANA_TOOLS_DEPENDENCIES=
