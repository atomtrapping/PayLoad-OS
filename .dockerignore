# Default deny: never send a whole operator checkout to the image builder.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!next.config.ts
!postcss.config.mjs
!src/
!src/**
!examples/
!examples/**
!scripts/
!scripts/earth-assets.mjs
!scripts/production-worker.entry.ts
!scripts/terminal-mining-worker.entry.ts
!scripts/terminal-service.entry.ts
!scripts/check-state-kernel-traces.mjs
!scripts/deployment-audit.mjs
!scripts/deployment-preflight.entry.ts
!scripts/gat-source.mjs
!scripts/gat-audit-runner.py
!native/
!native/state-kernel/
!native/state-kernel/Cargo.toml
!native/state-kernel/Cargo.lock
!native/state-kernel/src/
!native/state-kernel/src/**
!deploy/
!deploy/entrypoint.sh
# These exclusions remain last so future source allowlists cannot admit them.
**/.payload/**
**/.stamp/**
**/.git/**
**/.env*
**/node_modules/**
**/target/**
**/__pycache__/**
**/*.pyc
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.test.*
**/*.spec.*
src/test/**
src/db/fixtures/**
